# Copy this file to `.env` and fill in your keys. `.env` is gitignored — your
# secrets never get committed.

# --- Script stage (ChatGPT) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Voice stage (your cloned voice) ---
# ElevenLabs by default. Find your voice id at elevenlabs.io -> Voices -> (your
# clone) -> "ID". If you use a different service, edit workshop/stages/voice.py.
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Show identity (used on the episode page) ---
SHOW_NAME=Under the Scope
SHOW_HOST=Pastor Billy Daws
