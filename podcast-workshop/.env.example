# Copy this file to `.env` and fill in your key. `.env` is gitignored — your
# secrets never get committed.

# --- OpenAI: used for the script, transcription (Whisper), and images ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Show identity (used on the episode page, captions, and notes) ---
SHOW_NAME=Under the Scope
SHOW_HOST=Pastor Billy Daws

# --- Reel appeals (used in each reel's pinned first comment) ---
# Your giving / support page, your book's exact title, and its Amazon link.
SUPPORT_URL=
BOOK_TITLE=
BOOK_URL=

# Voices are generated by hand in CloneVoice — no API key needed for that step.
